# Create a brand-new Supabase project named for ISEE Arcade.
# Never use the KEMPCO/FSM project, URL, keys, database, or deployment.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-ISEE-ARCADE-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_ISEE_ARCADE_PUBLISHABLE_KEY

# Server only. Required for the private owner console to create, reset, suspend,
# and remove parent access. Never prefix this with NEXT_PUBLIC and never expose it
# in browser code.
SUPABASE_SERVICE_ROLE_KEY=YOUR_ISEE_ARCADE_SERVICE_ROLE_KEY
